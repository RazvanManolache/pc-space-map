<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../PcSpaceMap.Version.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PcSpaceMap.Index/PcSpaceMap.Index.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.16" />
  </ItemGroup>
  <Target Name="CopyExternalSqlite" AfterTargets="Publish"
          Condition="'$(PublishSingleFile)' == 'true' and '$(IncludeNativeLibrariesForSelfExtract)' == 'false' and '$(RuntimeIdentifier)' == 'win-x64'">
    <Copy SourceFiles="$(TargetDir)e_sqlite3.dll" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
