<Window x:Class="PcSpaceMap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PcSpaceMap"
        Title="PC Space Map" Icon="Assets/PcSpaceMap.ico" Width="1520" Height="960" MinWidth="920" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackground}" Foreground="{StaticResource PrimaryText}">
    <Window.Resources>
        <DataTemplate x:Key="DiskTabHeader">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                <Button Content="×" Command="{x:Static local:MainWindow.CloseTabCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=TabItem}}"
                        Background="Transparent" BorderBrush="Transparent" Margin="6,0,0,0" Padding="3,0"
                        ToolTip="Close tab" AutomationProperties.Name="{Binding StringFormat='Close {0} tab'}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.NewTabCommand}" Executed="NewTab_Executed" CanExecute="TabCommand_CanExecute"/>
        <CommandBinding Command="{x:Static local:MainWindow.ScanAllCommand}" Executed="ScanAll_Executed" CanExecute="TabCommand_CanExecute"/>
        <CommandBinding Command="{x:Static local:MainWindow.StopAllCommand}" Executed="StopAll_Executed" CanExecute="StopAll_CanExecute"/>
        <CommandBinding Command="{x:Static local:MainWindow.CloseTabCommand}" Executed="CloseTab_Executed" CanExecute="TabCommand_CanExecute"/>
    </Window.CommandBindings>
    <Grid x:Name="AppSurface" Margin="18,10,18,18" Background="{StaticResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="PC Space Map" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#102236" BorderBrush="#1F5267" BorderThickness="1" CornerRadius="5"
                        Padding="7,3" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="READ-ONLY SCANNER" Foreground="#67E8F9" FontSize="10" FontWeight="Bold"
                               ToolTip="Scanning is read-only. Right-click actions are provided by Windows and may change files."/>
                </Border>
                <Border Background="#102236" BorderBrush="#1F5267" BorderThickness="1" CornerRadius="5"
                        Padding="7,3" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock x:Name="AgentApiText" Text="LOCAL API · STARTING" Foreground="#67E8F9" FontSize="10" FontWeight="Bold"/>
                </Border>
                <TextBlock Text="App startup" VerticalAlignment="Center" Margin="4,0,5,0"/>
                <ComboBox x:Name="DesktopStartupBox" Width="147" Margin="0,0,6,0" VerticalAlignment="Center"
                          AutomationProperties.Name="App startup" ToolTip="Choose how PC Space Map opens when you sign in to Windows.">
                    <ComboBoxItem Content="Off" Tag="{x:Static local:DesktopStartupMode.Off}"/>
                    <ComboBoxItem Content="Start in tray" Tag="{x:Static local:DesktopStartupMode.Tray}"/>
                    <ComboBoxItem Content="Open main window" Tag="{x:Static local:DesktopStartupMode.Window}"/>
                </ComboBox>
                <Button Content="Windows Service…" Click="ServiceButton_Click" Margin="0" Padding="8,4" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" x:Name="DiskTabs">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                                <Button Content="+ New tab" Command="{x:Static local:MainWindow.NewTabCommand}" Padding="10,5"/>
                                <Button Content="Scan all drives" Command="{x:Static local:MainWindow.ScanAllCommand}" Padding="10,5"/>
                                <Button Content="Stop all scans" Command="{x:Static local:MainWindow.StopAllCommand}" Padding="10,5">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                        </DockPanel>
                        <Border Grid.Row="1" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
        </TabControl>
    </Grid>
</Window>
