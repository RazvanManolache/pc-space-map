<UserControl x:Class="PcSpaceMap.Controls.ScanWorkspaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PcSpaceMap.Controls"
             Background="{StaticResource AppBackground}"
             Foreground="{StaticResource PrimaryText}">
    <Grid Margin="6" Background="{StaticResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="RootPathBox" IsEditable="False" IsTextSearchEnabled="False" VerticalContentAlignment="Center" MinWidth="420" Margin="3"/>
                <Button Grid.Column="1" x:Name="BrowseButton" Content="Choose folder…" Click="BrowseButton_Click"/>
                <Button Grid.Column="2" x:Name="ScanButton" Content="Scan now" Style="{StaticResource PrimaryButton}" Click="ScanButton_Click"/>
                <Button Grid.Column="3" x:Name="RefreshFolderButton" Content="Update this folder" IsEnabled="False" Click="RefreshFolderButton_Click"/>
                <Button Grid.Column="4" x:Name="CancelButton" Content="Stop" IsEnabled="False" Click="CancelButton_Click"/>
                <Button Grid.Column="5" x:Name="ExportButton" Content="Export inventory…" IsEnabled="False" Click="ExportButton_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="SCANNED SIZE" Foreground="{StaticResource SecondaryText}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="TotalSizeText" Text="—" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="FILES" Foreground="{StaticResource SecondaryText}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="FileCountText" Text="—" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="FOLDERS" Foreground="{StaticResource SecondaryText}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="FolderCountText" Text="—" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
            </Border>
            <Border Grid.Column="3" Background="{StaticResource PanelBackground}" BorderBrush="#765A22" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel><TextBlock Text="REVIEW CANDIDATES" Foreground="#FACC15" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="CleanupSizeText" Text="—" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
            </Border>
        </Grid>

        <TabControl Grid.Row="2" x:Name="MainTabs">
            <TabItem Header="Space map">
                <Grid Background="{StaticResource AppBackground}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#0D1727" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="8,5">
                        <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal"/>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                        <Border Margin="8" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
                            <controls:TreemapControl x:Name="Treemap" NodeSelected="Treemap_NodeSelected" ZoomRequested="Treemap_ZoomRequested"/>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1,0,0,0" Padding="18">
                            <StackPanel>
                                <TextBlock Text="SELECTED ITEM" Foreground="{StaticResource SecondaryText}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="SelectedNameText" Text="Nothing selected" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock x:Name="SelectedSizeText" Text="—" FontSize="28" FontWeight="Light" Foreground="{StaticResource Accent}" Margin="0,8,0,0"/>
                                <TextBlock x:Name="SelectedContentsText" Text="Click a rectangle to inspect it. Double-click folders to zoom." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <Separator Background="{StaticResource PanelBorder}" Margin="0,18"/>
                                <TextBlock Text="LOCATION" Foreground="{StaticResource SecondaryText}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="SelectedPathText" Text="—" TextWrapping="Wrap" Margin="0,7,0,12"/>
                                <Button x:Name="OpenSelectedButton" Content="Open in Explorer" IsEnabled="False" Click="OpenSelectedButton_Click" HorizontalAlignment="Stretch"/>
                                <Button x:Name="ZoomSelectedButton" Content="Zoom into folder" IsEnabled="False" Click="ZoomSelectedButton_Click" HorizontalAlignment="Stretch"/>
                                <Button x:Name="RefreshSelectedButton" Content="Update selected folder" IsEnabled="False" Click="RefreshFolderButton_Click" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Largest files">
                <Grid Background="{StaticResource AppBackground}" Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="The 5,000 largest files found. Double-click a row to reveal it in Explorer." Foreground="{StaticResource SecondaryText}" Margin="4,5,4,10"/>
                    <DataGrid Grid.Row="1" x:Name="LargestFilesGrid" AutoGenerateColumns="False" MouseDoubleClick="LargestFilesGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="110" SortMemberPath="Size"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding TypeText}" Width="90"/>
                            <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedText}" Width="145" SortMemberPath="LastWriteUtc"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding Path}" Width="4*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Cleanup review">
                <Grid Background="{StaticResource AppBackground}" Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Suggestions are grouped and advisory. Double-click to inspect the largest example; clean through the owning app or Windows when possible." Foreground="{StaticResource SecondaryText}" Margin="4,5,4,10" TextWrapping="Wrap"/>
                    <DataGrid Grid.Row="1" x:Name="CleanupGrid" AutoGenerateColumns="False" MouseDoubleClick="CleanupGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="190"/>
                            <DataGridTextColumn Header="Confidence" Binding="{Binding ConfidenceText}" Width="110"/>
                            <DataGridTextColumn Header="Potential" Binding="{Binding SizeText}" Width="110" SortMemberPath="Size"/>
                            <DataGridTextColumn Header="Files" Binding="{Binding FileCountText}" Width="85" SortMemberPath="FileCount"/>
                            <DataGridTextColumn Header="Why it was flagged" Binding="{Binding Reason}" Width="3*"/>
                            <DataGridTextColumn Header="Largest example" Binding="{Binding SamplePath}" Width="3*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="2" Background="#2A2010" BorderBrush="#765A22" BorderThickness="1" CornerRadius="6" Padding="11" Margin="0,10,0,0">
                        <TextBlock Text="Important: review candidates are not guaranteed reclaimable space. Some files may be active, recreated immediately, or retained for recovery and diagnostics." Foreground="#FDE68A" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Scan notes">
                <Grid Background="{StaticResource AppBackground}" Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="IssueSummaryText" Text="Locked or inaccessible paths will appear here." Foreground="{StaticResource SecondaryText}" Margin="4,5,4,10"/>
                    <DataGrid Grid.Row="1" x:Name="IssuesGrid" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="3*"/>
                            <DataGridTextColumn Header="What happened" Binding="{Binding Message}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="2,10,2,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ProgressBar x:Name="ScanProgressBar" Width="150" Height="5" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" x:Name="StatusText" Text="Ready to scan." Foreground="{StaticResource SecondaryText}" Margin="10,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" x:Name="ElapsedText" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
