<Window x:Class="PcSpaceMap.CloseTabDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Close tab" Width="365" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource {x:Type Window}}">
    <StackPanel Margin="18">
        <TextBlock x:Name="Prompt" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <TextBlock x:Name="PathText" TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Keep tab" IsCancel="True" IsDefault="True"/>
            <Button Content="Close tab" Click="Close_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
